# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Polymarket API key (requests are signed with Ed25519; sent as X-PM-Access-Key / X-PM-Timestamp / X-PM-Signature)
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=pplx-decider-latest

# Database: set POSTGRES_URL (Supabase via Vercel sets it for you) to use Postgres;
# leave it empty to use the local SQLite file below.
POSTGRES_URL=
ODDS_ARENA_DB=odds_arena.db
# Comma-separated model names to run (see odds_arena/models/__init__.py)
ODDS_ARENA_MODELS=market,coinflip,openai

# Vercel Cron: Vercel sends `Authorization: Bearer $CRON_SECRET`; generate with `openssl rand -hex 32`
CRON_SECRET=
# Markets per daily predict run, and seconds before a cron run stops starting new work
CRON_PREDICT_LIMIT=10
CRON_WITHIN_DAYS=30
CRON_TIME_BUDGET=45
